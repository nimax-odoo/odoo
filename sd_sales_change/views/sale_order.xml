<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order form view -->
    <record id="view_order_form_inherit_change_view" model="ir.ui.view">
        <field name="name">view.order.form.inherit.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning p-3 text-center" role="alert" invisible="not is_picking_assigned">
                    <span>La orden de entrega ya esta lista para entregar los productos, por favor proceda!</span>
                </div>
            </xpath>


        </field>
    </record>
    <record id="view_order_tree_inherit_change_view" model="ir.ui.view">
        <field name="name">view.order.tree.inherit.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="is_picking_assigned" />
            </xpath>
        </field>
    </record>
</odoo>