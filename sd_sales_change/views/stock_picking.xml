<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_inherit_change_view" model="ir.ui.view">
        <field name="name">view.stock.picking.tree.inherit.view</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='products_availability']" position="after">
                <field name="id_notify_assigned" />
            </xpath>
        </field>
    </record>
</odoo>