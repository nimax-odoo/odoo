<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="bi_account_multi_payment_wizard_form">
            <field name="name">account.multi.payment.wizard.form</field>
            <field name="model">account.multi.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="Payment Wizard">
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id" required="1"/>
                            </group>
                            <group>
                                <field name="partner_type" readonly="0"/>
                                <field name="payment_type" readonly="1"/>
                            </group>
                        </group>
                        <group string="Payment">
                            <group>
                                <field name="move_line_id" options="{'no_open': True, 'no_create': True}" domain="[('partner_id', '=', partner_id), ('reconciled', '=', False),('move_type','=','entry'),('credit', '>', 0), ('debit', '=', 0)]"
                                readonly="not partner_id" required="partner_id"/>
                                <field name="currency_id"/>
                            </group>
                            <group>
                                <field name="company_id" readonly="1" invisible="1"/>
                                <field name="company_currency_id" readonly="1" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="amount_residual"/>
                                <field name="amount_residual_currency" invisible="not currency_id"/>
                            </group>
                            <group>
                                <field name="remain_amount"/>
                                <field name="remain_amount_currency" invisible="not currency_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Move Lines">
                                <field name="move_lines_ids" nolabel="1" context="{'default_partner_id': partner_id}">
                                    <list editable="bottom">
                                        <field name="invoice_id" required="1" context="{'partner_id' : parent.partner_id, 'type' : parent.payment_type}" options="{'no_open': True, 'no_create': True}" domain="[('partner_id', '=', parent.partner_id),('move_type','=','in_invoice'),('amount_residual','!=',0.0)]" column_invisible="parent.payment_type == 'payin'"/>

                                       <field name="invoice_id" required="1" context="{'partner_id' : parent.partner_id, 'type' : parent.payment_type}" options="{'no_open': True, 'no_create': True}" domain="[('partner_id', '=', parent.partner_id),('move_type','=','out_invoice'),('amount_residual','!=',0.0)]" column_invisible="parent.payment_type == 'payout'"/>
                                       
                                        <field name="partner_id" context="{'default_partner_id' : parent.partner_id}" column_invisible="1"/>
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="move_line_id" column_invisible="1"/>
                                        <field name="currency_id"/>
                                        <field name="pay_remaining_amount" force_save="1"/>
                                        <field name="amount_total"  force_save="1"/>
                                        <field name="amount_residual" force_save="1"/>
                                        <field name="amount_to_pay" force_save="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button string="Discard" class="btn btn-secondary" special="cancel"/>
                        <button name="multi_partial_pay" string=" Register Payment " type="object" class="btn btn-primary" icon="fa-money" style="float: right;"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_partial_account_payments" model="ir.actions.act_window">
            <field name="name">Partial Payments</field>
            <field name="res_model">account.multi.payment.wizard</field>
            <field name="view_mode">form</field>
            <field name="context">{
                'default_partner_type': 'customer',
            }</field>
            <field name="target">new</field>
        </record>

        <record id="action_partial_account_payments_payable" model="ir.actions.act_window">
            <field name="name">Partial Payments</field>
            <field name="res_model">account.multi.payment.wizard</field>
            <field name="view_mode">form</field>
            <field name="context">{
                'default_partner_type': 'supplier',
            }</field>
            <field name="target">new</field>
        </record>

        <menuitem action="action_partial_account_payments" id="menu_action_partial_account_payments_receivable" parent="account.menu_finance_receivables" sequence="16"/>
        <menuitem action="action_partial_account_payments_payable" id="menu_action_partial_account_payments_payable" parent="account.menu_finance_payables" sequence="21"/>

    </data>
</odoo>
