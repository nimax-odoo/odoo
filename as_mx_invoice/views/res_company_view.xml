<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_company_form_inherit_as_mx_invoice" model="ir.ui.view">
            <field name="name">res.company.form.inherit.as_mx_invoice</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <!-- Buscar un lugar lógico donde poner los campos, por ejemplo, cerca de la info fiscal -->
                <xpath expr="//notebook" position="inside">
                    <page string="Facturación Electrónica MX (PAC)" name="mx_edi_pac_config">
                        <group>
                            <group string="Configuración PAC (Proveedor Autorizado de Certificación)">
                                <field name="l10n_mx_edi_pac"/>
                                <field name="l10n_mx_edi_pac_username"/>
                                <field name="l10n_mx_edi_pac_password" />
                                <field name="l10n_mx_edi_pac_test_env"/>
                                <field name="l10n_mx_edi_fiscal_regime"/> <!-- Agregamos régimen fiscal también -->
                            </group>
                        </group>
                        <!-- <group string="Certificados CSD">
                            <field name="l10n_mx_edi_certificate_ids" nolabel="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="serial_number"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="is_valid"/>
                                </tree>
                            </field>
                        </group> -->
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo> 