                            }

                            .table_info {
                                border: 2px solid #fff;
                                width: 100%;
                                font-size: 10px !important;
                            }

                            .invoice_tbody tr .border {
                                border-left: 2px solid #8c8c8c !important;
                                border-right: 2px solid #8c8c8c !important;
                                font-size: 13px !important;
                            }

                            .parrafo2 {
                                font-size: 12px;
