                        <span> | Certification Date:</span> <span t-out="o.detalle_folio().get('stamp_date')">2023-09-12</span>
                        <span> | Fiscal Folio:</span> <span t-out="o.detalle_folio().get('uuid')">No identificado</span>
                                                <br />
                                            </div>


                                        </td>
                                    </tr>
                                </t>
                            </tbody>

                        </table>

                    </div>

