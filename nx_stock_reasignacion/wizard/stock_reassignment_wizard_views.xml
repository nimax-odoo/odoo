<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nx_stock_reassignment_wizard_form" model="ir.ui.view">
        <field name="name">nx.stock.reassignment.wizard.form</field>
        <field name="model">nx.stock.reassignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Reasignar piezas">
                <group>
                    <group string="Origen">
                        <field name="source_order_id"/>
                        <field name="available_source_move_ids" invisible="1"/>
                        <field name="source_move_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="product_id"/>
                        <field name="source_reserved_qty"/>
                    </group>
                    <group string="Destino">
                        <field name="available_destination_order_ids" invisible="1"/>
                        <field name="destination_order_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="available_destination_move_ids" invisible="1"/>
                        <field name="destination_move_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="destination_pending_qty"/>
                        <field name="quantity"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    La operacion cambia la reserva real de inventario. No modifica las cantidades vendidas ni crea movimientos adicionales.
                </div>
                <footer>
                    <button name="action_reassign" type="object" string="Reasignar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
