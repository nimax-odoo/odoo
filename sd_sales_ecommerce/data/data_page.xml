<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="sd_sales_ecommerce.access_successful" name="Access Successful">
        <t t-call="website.layout">
            <t t-set="logged_partner" t-value="request.env['website.visitor']._get_visitor_from_request().partner_id" />
            <t t-set="contactus_form_values"
                t-value="{                 'email_to': res_company.email,                 'name': request.params.get('name', ''),                 'phone': request.params.get('phone', ''),                 'email_from': request.params.get('email_from', ''),                 'company': request.params.get('company', ''),                 'subject': request.params.get('subject', ''),             }" />
            <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values" />
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                    data-snippet="s_title" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg"
                        style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;" />
                    <div class="o_we_bg_filter bg-black-50" />
                    <div class="container">
                        <h1>Registrar Acceso</h1>
                    </div>
                </section>
                <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-7 mt-4 mt-lg-0">
                                <p class="lead">
                                    Registre su acceso completando su identificación, si no es encontrado en el sistema,
                                    debe comunicarse con el administrador para ingresar su información a la plataforma.
                                </p>
                                <section class="s_website_form formulario_acces" data-vcss="001"
                                    data-snippet="s_website_form">
                                    <div class="container">
                                        <t t-if="request.params.get('error')">
                                            <div class="alert alert-danger" role="alert">
                                                <t t-if="request.params.get('error') == 'missing_vat'">
                                                    Debe ingresar un número de documento válido.
                                                </t>
                                                <t t-if="request.params.get('error') == 'partner_not_found'">
                                                    No se encontró un cliente con ese documento.
                                                </t>
                                                <t t-if="request.params.get('error') == 'missing_email'">
                                                    El cliente no tiene un correo registrado.
                                                </t>
                                                <t t-if="request.params.get('error') == 'user_already_exists'">
                                                    El usuario ya está registrado.
                                                </t>
                                                <t t-if="request.params.get('error') == 'unexpected_error'">
                                                    Ocurrió un error inesperado. Intente nuevamente.
                                                </t>
                                            </div>
                                        </t>
                                        <form id="login_form" action="/website/form/" method="post" enctype="multipart/form-data" class="o_mark_required" data-mark="*" data-pre-fill="true" data-success-mode="redirect" data-success-page="/login-successful-thanks" data-model_name="res.access.portal" hide-change-model="true">

                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                                            <input type="hidden" name="website" t-att-value="website" />

                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                    data-type="text" data-name="Field">
                                                    <label class="s_website_form_label" style="width: 200px"
                                                        for="contact6">
                                                        <span class="s_website_form_label_content">RFC</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input type="text" class="form-control s_website_form_input"
                                                        name="vat" id="vat" required="" data-fill-with="vat" />
                                                </div>
                                                <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                    data-type="text" data-name="Field">
                                                    <label class="s_website_form_label" style="width: 200px"
                                                        for="contact6">
                                                        <span class="s_website_form_label_content">Nombre</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input type="text" class="form-control s_website_form_input"
                                                        name="name" required="" data-fill-with="name" id="name"
                                                        readonly="readonly" />
                                                </div>
                                                <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                    data-type="text" data-name="Field">
                                                    <label class="s_website_form_label" style="width: 200px"
                                                        for="contact6">
                                                        <span class="s_website_form_label_content">Email</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <input type="text" class="form-control s_website_form_input"
                                                        name="email" id="email" required="" data-fill-with="email" />
                                                </div>

                                                <div class="mb-3 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                    data-type="text" data-name="Field">
                                                    <label class="s_website_form_label" style="width: 200px"
                                                        for="contact6">
                                                        <span class="s_website_form_label_content">Nota</span>
                                                        <span class="s_website_form_mark"> *</span>
                                                    </label>
                                                    <textarea id="contact6" class="form-control s_website_form_input"
                                                        name="description" required="" rows="8" />
                                                    </div>
                                                
                                               <!-- <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" data-name="Submit Button">
                                                    <div style="width: 200px;" class="s_website_form_label"/>
                                                    <a href="#" role="button" class="btn btn-primary s_website_form_send">Submit</a>
                                                    <span id="s_website_form_result"></span>
                                                </div> -->
                                                 <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" data-name="Submit Button">
                                                    <div style="width: 200px;" class="s_website_form_label"/>
                                                    <a href="#" role="button" class="btn btn-primary s_website_form_send">Enviar</a>
                                                    <span id="s_website_form_result"></span>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </section>
                            </div>
                            <div class="col-lg-4 offset-lg-1 mt-4 mt-lg-0">
                                <h5>My Company</h5>
                                <ul class="list-unstyled mb-0 ps-2">
                                    <li><i class="fa fa-map-marker fa-fw me-2"/><span class="o_force_ltr">3575 Fake Buena Vista Avenue</span></li>
                                    <li><i class="fa fa-phone fa-fw me-2"/><span class="o_force_ltr">+1 555-555-5556</span></li>
                                    <li><i class="fa fa-1x fa-fw fa-envelope me-2"/><span>info@yourcompany.example.com</span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
        <record id="access_successful_page" model="website.page">
        <field name="is_published">True</field>
        <field name="url">/access_successful</field>
        <field name="view_id" ref="sd_sales_ecommerce.access_successful" />
        <field name="track">True</field>
        <field name="website_meta_description">This is the access successful page of the website</field>
    </record>
        <record id="sd_sales_ecommerce.access_successful_thanks" model="website.page">
        <field name="name">Gracias (login)</field>
        <field name="type">qweb</field>
        <field name="url">/login-successful-thanks</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">sd_sales_ecommerce.access_successful_thanks</field>
        <field name="arch" type="xml">
            <t name="Gracias (login)" t-name="sd_sales_ecommerce.access_successful_thanks">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-6 offset-lg-1 text-center">
                                        <div class="d-inline-block mx-auto p-4">
                                            <i class="fa fa-paper-plane fa-2x mb-3 rounded-circle text-bg-success" role="presentation"/>
                                            <h1 class="fw-bolder">Gracias!</h1>
                                            <p class="lead mb-0">Tu regsitro se ha creado satisfactoriamente.</p>
                                            <p class="lead">Revisa tu correo para crear la contraseña y puedas iniciar sesión.</p>
                                            <a href="/">ir a Home</a>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 offset-lg-1">
                                        <h5>My Company</h5>
                                        <ul class="list-unstyled mb-0 ps-2">
                                            <li><i class="fa fa-map-marker fa-fw me-2"/><span class="o_force_ltr">3575 Fake Buena Vista Avenue</span></li>
                                            <li><i class="fa fa-phone fa-fw me-2"/><span class="o_force_ltr">+1 555-555-5556</span></li>
                                            <li><i class="fa fa-1x fa-fw fa-envelope me-2"/><span>info@yourcompany.example.com</span></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <input t-if='website.plausible_shared_key' type='hidden' class='js_plausible_push' data-event-name='Lead Generation' data-event-params='{"CTA": "Contact Us"}' />
                </t>
            </t>
        </field>
    </record>

</odoo>