<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="as_res_access_portal_view" model="ir.ui.view">
            <field name="name">res.access.portal.tree.view</field>
            <field name="model">res.access.portal</field>
            <field name="arch" type="xml">
                <list string="Acceso al portal" editable="bottom" multi_edit="1">
                    <field name="name"/>
                    <field name="vat"/>
                    <field name="email"/>
                    <field name="partner_id"/>
                    <field name="notas"/>
                </list>
            </field>
        </record>

        <record id="as_res_access_portal_form" model="ir.ui.view">
            <field name="name">res.access.portal.form.view</field>
            <field name="model">res.access.portal</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="vat"/>
                            <field name="email"/>
                            <field name="partner_id"/>
                            <field name="notas"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="as_res_access_portal_action" model="ir.actions.act_window">
            <field name="name">Acceso al portal</field>
            <field name="res_model">res.access.portal</field>
            <field name="view_mode">list,form</field>
        </record> 

        <menuitem id="as_res_access_portal_action_menu" name="Acceso al portal"
            parent="website.menu_website_global_configuration" sequence="30"
            action="as_res_access_portal_action" groups="base.group_user"
        />

    </data>
</odoo>