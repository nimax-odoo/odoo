<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="bi_view_coupon_program_add_inherit" model="ir.ui.view">
            <field name="name">view.coupon.program.field.add.inherit</field>
            <field name="model">coupon.program</field>
            <field name="inherit_id" ref="as_sale_pricelist.view_coupon_program_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//field[@name='promo_code_usage']" position="after">
                    <field name="sd_apply_toprunner_ecommerce" />
                </xpath>
            </field>
        </record>
        <record model="ir.actions.server" id="action_account_reports_tarifas_do_followup">
            <field name="name">Asignar Tarifas a Contacto</field>
            <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner" />
            <field name="state">code</field>
            <field name="code">
                if records:
                    action = records.action_assigned_vendor()
            </field>
        </record>
                <record id="bi_view_product_temple_add_inherit" model="ir.ui.view">
            <field name="name">product.template.product.formt</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
            	<xpath expr="//field[@name='barcode']" position="after">
                    <field name="free_qty" />
                    <field name="stock_status" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
