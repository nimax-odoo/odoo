<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de la vista de formulario de res.users -->
    <record id="sd_view_users_ecommerce_form" model="ir.ui.view">
        <field name="name">sd.res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Ecommerce" groups="base.group_system">
                <header><button name="action_cleaner_cache" type="object" string="Actualizar Cache" class="oe_highlight" /></header>
                    <group>
                        <field name="sd_desc_percentaje" widget="percentage"/>
                         <field name="sd_pricelist_ids"  widget="many2many_tags"/>
                        <field name="sd_reserva_stock"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
    <record id="sd_view_partner_ecommerce_form" model="ir.ui.view">
        <field name="name">sd.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Ecommerce" groups="base.group_system">
                <header><button name="action_cleaner_cache" type="object" string="Actualizar Cache" class="oe_highlight" /></header>
                    <group>
                        <field name="sd_desc_percentaje" widget="percentage"/>
                        <field name="sd_pricelist_ids"  widget="many2many_tags"/>
                        <field name="sd_reserva_stock"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
