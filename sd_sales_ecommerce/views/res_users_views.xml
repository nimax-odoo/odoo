<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de la vista de formulario de res.users -->
    <record id="sd_view_users_ecommerce_form" model="ir.ui.view">
        <field name="name">sd.res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Ecommerce" groups="base.group_system">
                <header>
                <button name="action_cleaner_cache" type="object" string="Actualizar Cache" class="oe_highlight" />
                <button name="oe_highlight" />
                <button name="compute_price_api" type="object" string="Calcular Precios" class="oe_highlight" />
                
                </header>
                    <group>
                        <field name="as_partner_id"/>
                        <field name="as_stock_percentaje" widget="percentage"/>
                         <field name="as_pricelist" />
                        <field name="sd_reserva_stock"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
    <record id="sd_view_partner_ecommerce_form" model="ir.ui.view">
        <field name="name">sd.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Ecommerce" groups="base.group_system">
                <header><button name="action_cleaner_cache" type="object" string="Actualizar Cache" class="oe_highlight" />
                <button name="compute_price_api" type="object" string="Calcular Precios" class="oe_highlight" />
                </header>
                    <group>
                        <field name="as_partner_id"/>
                        <field name="as_stock_percentaje" widget="percentage"/>
                        <field name="property_product_pricelist"/>
                        <field name="sd_reserva_stock"/>
                    </group>
                    <field name="user_api_ecommerce_ids">
                        <list>
                            <field name="create_date"/>
                            <field name="name"/>
                            <field name="as_partner_id"/>
                            <field name="property_product_pricelist"/>
                            <field name="as_stock_percentaje" widget="percentage"/>

                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
