    <!--    Products-->
    <template id="custom_product_stock_status" inherit_id="website_sale.products_item" active="False">
        <xpath expr="//div[hasclass('product_price')]" position="after">
            <b><t t-esc="website._get_current_pricelist().currency_id.name"/></b>
            <t t-set="tmpl_id" t-value="product.id"/>
            <t t-set="qty" t-value="(stock_map.get(tmpl_id) or 0) if stock_map else 0"/>
            <div t-if="product.sudo().stock_status == 'in_stock'" class="text-success">
                En Stock <t t-esc="int(qty or 0)"/> Unid.
            </div>
            <div t-if="product.sudo().stock_status == 'out_of_stock'" class="text-danger">
                Agotado
            </div>
        </xpath>
    </template>
    <!--Notification For Filter-->
    <template inherit_id="website_sale.products" id="products_inherit" name="Products">
        <xpath expr="//span[@t-if='isFilteringByPrice or attrib_set or tags']" position="attributes">
            <attribute name="t-if">isFilteringByPrice or attrib_set or tags or show_only_in_stock</attribute>
        </xpath>
    </template>

    <!--Mobile Canvas-->
    <template id="o_wsale_offcanvas_inherit" inherit_id="website_sale.o_wsale_offcanvas" name="Offcanvas">
        <xpath expr="//div[hasclass('offcanvas-body')][2]" position="replace">
            <div class="offcanvas-body d-flex justify-content-between flex-grow-0 border-top overflow-hidden">
                <a t-attf-class="btn btn-{{navClass}} d-flex py-1 mb-2 {{(not attrib_values and not isFilteringByPrice and not tags and not show_only_in_stock) and 'disabled' }}"
                   t-att-aria-disabled="(not attrib_values and not isFilteringByPrice and not tags and not show_only_in_stock) and 'true' or 'false'"
                   href="/shop"
                   title="Borrar filtros">
                    Borrar filtros
                </a>
            </div>
        </xpath>

