<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="cron_cyberpuerta_full_catalog" model="ir.cron">
            <field name="name">Cyberpuerta Full Catalog</field>
            <field name="model_id" ref="product.model_product_template" />
            <field name="state">code</field>
            <field name="code">model.send_full_catalog_cyberpuerta(1)</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
        </record>
        <record id="ir_cron_update_data_price_product" model="ir.cron">
            <field name="name">NIMAX: Actualizar precios de productos por clientes</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="as_stock_api.model_sd_compute_product_price" />
            <field name="code">model.syn_cron_prices()</field>
            <field name="state">code</field>
        </record>


    </data>
</odoo>