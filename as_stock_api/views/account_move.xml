<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="bi_view_account_move_add_inherit" model="ir.ui.view">
            <field name="name">account.move.field.add.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//button[@name='preview_invoice']" position="after">
                <button name="send_invoice_cyberpuerta" string="Referencia" type="object" invisible="move_type not in ('out_invoice', 'in_invoice')" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
