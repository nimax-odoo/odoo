<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="bi_view_sale_order_add_inherit" model="ir.ui.view">
            <field name="name">view.sale.order.field.add.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
            	<xpath expr="//field[@name='source_id']" position="after">
                    <field name="sd_waybills" />
                    <field name="sd_carrier_id" />
                </xpath>
                <xpath expr="//sheet" position="after">
                    <div class="o_attachment_preview o_center_attachment"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
