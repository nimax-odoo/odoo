<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de la vista de formulario de res.users -->
    <record id="as_view_users_form" model="ir.ui.view">
        <field name="name">as.res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="API de Stock" groups="base.group_system">
                    <group>
                    <group>
                        <field name="as_api_enabled"/>
                        <field name="as_api_key" invisible="not as_api_enabled" readonly="not as_api_enabled"/>
                        <div class="text-muted" invisible="not as_api_enabled">
                            Puede editar manualmente la clave API o usar los botones para generarla automáticamente.
                        </div>
                    </group>
                    <group>

                        <field name="sd_sync_lock_until" invisible="not as_api_enabled"/>
                        <label for="sd_sync_lock_until_cant" invisible="not as_api_enabled"/>
                        <div class="o_row"  invisible="not as_api_enabled">
                                <field name="sd_sync_lock_until_cant"/>
                                <field name="sd_sync_lock_until_type"/>

                        </div>

                    </group>
                    </group>

                    <group string="API para la Gestion de Ventas (CYBERPUERTA)">
                    <group>
                        <field name="sd_cy_token"/>
                        <div class="text-muted" invisible="not sd_cy_token">
                            Token sugerido por Cyberpuerta para el uso en su sistema, en caso de otro cliente establecer uno.
                        </div>
                    </group>
                     <group>
                        <field name="sd_cy_webhook_active"/>
                        <div class="text-muted" invisible="not sd_cy_webhook_active">
                            Url del cliente para enviar catalogo de productos a esta URL se le concatena /api/proveedor/artículos/catálogo-completo.
                        </div>
                    </group>
                     <group invisible="not sd_cy_webhook_active">
                        <field name="sd_cy_url"/>
                        <div class="text-muted" invisible="not sd_cy_url and not sd_cy_webhook_active">
                            Url del cliente para enviar catalogo de productos a esta URL se le concatena /api/proveedor/artículos/catálogo-completo.
                        </div>
                    </group>
                    </group>

                    <group string="API Inventario" invisible="not as_api_enabled">
                    <group>
                        <field name="as_stock_percentaje" required="as_api_enabled" widget="percentage"/>
                        <div class="text-muted">
                            Porcentaje del stock real que se mostrará en la API. Por ejemplo, 80% mostrará el 80% del stock real.
                        </div>
                    </group>
                    <group>
                        <field name="as_pricelist" invisible="not as_api_enabled"/>
                        <div class="text-muted">
                            Lista de precios que se utilizará por defecto en la API de Stock con precios. Si se deja vacío, se usará la lista de precios del cliente.
                        </div>
                    </group>
                    <group>
                        <field name="as_partner_id" invisible="not as_api_enabled"/>
                        <div class="text-muted">
                            Cliente que se utilizará por defecto en las consultas de la API de Stock con precios. Si se especifica, no será necesario incluir el parámetro partner_id en las llamadas a la API.
                        </div>
                    </group>
                    <group>
                        <field name="as_warehouse_ids" invisible="not as_api_enabled" widget="many2many_tags" options="{'no_create': True}"/>
                        <div class="text-muted">
                            Almacenes cuyos productos se mostrarán en la API. Si no se selecciona ninguno, se mostrarán todos los almacenes.
                        </div>
                    </group>
                    </group>
                    <group invisible="not as_api_enabled">
                        <button name="as_generate_api_key" 
                                string="Generar Nueva Clave" 
                                type="object" 
                                class="btn-primary"/>
                        <button name="as_clear_api_key" 
                                string="Eliminar Clave" 
                                type="object" 
                                class="btn-secondary ml-2"/>
                    </group>
                    
                    <!-- Campo para mostrar y copiar la clave API -->
                    <group invisible="not as_api_enabled or not as_api_key">
                        <field name="as_api_key_display" readonly="1" widget="CopyClipboardChar" 
                               string="Clave API (para copiar)" class="text-break"/>
                        <button name="as_copy_api_key" 
                                string="Copiar al Portapapeles" 
                                type="object" 
                                class="btn-info"/>
                    </group>
                    
                    <!-- Enlace para descargar la colección de Postman -->
                    <div class="alert alert-success" role="alert" invisible="not as_api_enabled or not as_api_key">
                        <p>
                            <strong>Colección de Postman:</strong>
                        </p>
                        <p>
                            Descargue la colección de Postman preconfigurada con su clave API para probar la API de Stock.
                        </p>
                        <p>
                            <a href="/nimax/stock/postman_collection" class="btn btn-success" target="_blank" role="button">
                                <i class="fa fa-download"/> Descargar Colección de Postman
                            </a>
                        </p>
                    </div>
                    
                    <div class="alert alert-info" role="alert" invisible="not as_api_enabled">
                        <p>
                            <strong>Instrucciones:</strong>
                        </p>
                        <p>
                            Para usar la API de Stock, envíe una solicitud POST a <code>/nimax/stock</code> con la clave API en el cuerpo JSON:
                        </p>
                        <pre class="bg-light p-2 rounded">
{
  "api_key": "SU_CLAVE_API",
  "default_code": "PROD001",  // Opcional
  "location_id": 8  // Opcional
}
                        </pre>
                        <p>
                            <strong>Respuesta:</strong>
                        </p>
                        <pre class="bg-light p-2 rounded">
[
  {
    "location": "Stock",
    "product_code": "PROD001",
    "product_name": "Producto A",
    "stock": 10.0
  },
  ...
]
                        </pre>
                        <p class="text-muted mt-2">
                            <i class="fa fa-info-circle"/> Nota: El método GET y el parámetro product_id siguen disponibles por compatibilidad, pero se recomienda usar POST con default_code para mayor seguridad.
                        </p>
                        <p class="text-success">
                            <i class="fa fa-check-circle"/> Nuevo: La API ahora agrupa automáticamente los resultados duplicados por ubicación y código de producto, sumando las cantidades para proporcionar una respuesta más limpia.
                        </p>
                    </div>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
