<?xml version="1.0" ?>
<odoo>

    <!-- Mail template are declared in a NOUPDATE block
         so users can freely customize/delete them -->

    <data>

        <record id="email_template_ajustment_stock" model="mail.template">
            <field name="name">Inventario: Notificar al realizar un ajuste</field>
            <field name="model_id" ref="stock.model_stock_quant" />
            <field name="email_from">{{ (object.company_id.email_formatted) }}</field>
            <!-- <field name="partner_to">{{ object.user_id.partner_id.id }}</field> -->
            <field name="subject">{{ object.create_uid.name }} realizó un ajuste de inventario en {{ object.company_id.name }}</field>
            <field name="description">Correo para avisar que han realizado un ajuste de inventario</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Estimado/a
                        <br /><br />
                        Se notifica que el usuario <span style="font-weight:bold;"
                            t-out="object.create_uid.name or ''">Usuario</span> ha realizado un ajuste de inventario en
                        la compañía <span style="font-weight:bold;"
                            t-out="object.company_id.name or ''">Compañía</span>.
                        <br /><br />
                        <b>Detalles del ajuste:</b>
                        <br />
                        - Producto: <span style="font-weight:bold;"
                            t-out="object.product_id.display_name or ''">Producto A</span>
                        <br />
                        - Ubicación: <span style="font-weight:bold;"
                            t-out="object.location_id.display_name or ''">Ubicación B</span>
                        <br />
                        - Cantidad ajustada: <span style="font-weight:bold;" t-out="object.quantity or ''">10</span>
                        <br />
                        - Motivo del ajuste: <span style="font-weight:bold;" t-out="object.sd_description or ''">Motivo
                            del ajuste</span>
                        <br /><br />
                        Por favor, revise el sistema para más detalles.
                        <br /><br />
                        Saludos cordiales,
                        <br />
                        <t t-out="object.company_id.name or ''">Compañía</t>



                        <br /><br />
                        No dude en ponerse en contacto con nosotros si tiene alguna pregunta.
                        <t t-if="not is_html_empty(object.create_uid.signature)">
                            <br /><br />
                            <t t-out="object.create_uid.signature or ''">--<br />Mitchell Admin</t>
                        </t>
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[]" />
            <field name="lang">{{ object.create_uid.partner_id.lang }}</field>
            <field name="auto_delete" eval="True" />
        </record>
    </data>
</odoo>