<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Sale Order form view -->
	<record id="view_order_form_inherit_view" model="ir.ui.view">
		<field name="name">view.order.form.inherit.view</field>
		<field name="model">sale.order</field>
		<field name="inherit_id" ref="sale.view_order_form"/>
		<field name="priority">55</field>
		<field name="arch" type="xml">
			<!-- Campos en el formulario principal -->
			<field name="payment_term_id" position="after">
				<field name="sd_block_user"/>
				<field name="last_promo_id" invisible="1"/>
				<field name="currency_aux_id" options="{'no_create': True}"/>
				<field name="as_margin"/>
				<field name="is_copy" invisible="1"/>
				<field name="as_aprobe" invisible="1"/>
			</field>
			
			<xpath expr="//field[@name='pricelist_id']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			
			<xpath expr="//field[@name='partner_shipping_id']" position="after">
				<field name="as_zebra_sale" />
				<field name="as_usuario_final" invisible="as_zebra_sale == False" required="as_zebra_sale == True"/>
			</xpath>

			<xpath expr="//button[@name='action_unlock']" position="after">
                <button name="action_update_quantity" type="object" string="Ajustar Cantidades" invisible="state != 'sale'" groups="sales_team.group_sale_manager"/> 
			</xpath>
            <xpath expr="//field[@name='order_line']//list/field[@name='price_total']" position="after">
				<field name="as_product_comisionable" invisible="1"/>
						<button name="pricelist_apply" type="object" invisible="as_product_comisionable != False" string="Precios" icon="fa-cart-plus"/>
						<button name="promo_apply" type="object" invisible="as_product_comisionable != False" string="Promo" icon="fa-percent" context="{'as_pricelist_id': as_pricelist_id }"/>
			</xpath> 
            <xpath expr="//field[@name='order_line']//list/field[@name='product_uom_id']" position="after">
                <field name="as_pricelist_id" optional="show" string="Lista Precio" options="{'no_create': True}"/>
				
			</xpath>
	
		
		</field>
	</record>
	
</odoo>