<odoo>
    <data>

        <record model="ir.ui.view" id="tf_history_promo_tree_view">
            <field name="name">tf.history.promo.tree.view</field>
            <field name="model">tf.history.promo</field>
            
            <field name="arch" type="xml">
                <list string="Historial de Promociones">
                    <field name="sale_id"/>
                    <field name="sale_order_line"/>
                    <field name="promo_id"/>
                    <field name="vendor_id"/>
                    <field name="product_id"/>
                    <field name="customer_id"/>
                    <field name="qty"/>
                    <field name="last_applied_promo"/>
                    <field name="total_usd"/>
                    <field name="total_mxp"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="tf_history_promo_form_view">
            <field name="name">tf.history.promo.form.view</field>
            <field name="model">tf.history.promo</field>
            <field name="arch" type="xml">
                <form string="Historial de Promociones">
                    <sheet>
                        <group>
                            <group>
                                <field name="vendor_id"/>
                                <field name="product_id"/>
                                <field name="customer_id"/>
                                <field name="customer_type"/>
                                <field name="as_pricelist_id"/>
                                <field name="category_id"/>
                                <field name="qty"/>
                            </group>
                            <group>
                                <field name="recalculated_price_unit"/>
                                <field name="recalculated_price_unit_mxp"/>
                                <field name="recalculated_cost_nimax_usd"/>
                                <field name="recalculated_cost_nimax_mxp"/>
                                <field name="margin_mxp"/>
                                <field name="margin_usd"/>
                                <field name="total_usd"/>
                                <field name="total_mxp"/>
                            </group>
                            <group>
                                <field name="salesman_id"/>
                                <field name="sale_id"/>
                                <field name="sale_order_line"/>
                                <field name="promo_id"/>
                                <field name="last_applied_promo"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_account_invoice_ids_filter" model="ir.ui.view">
            <field name="name">tf.history.promo.search</field>
            <field name="model">tf.history.promo</field>
            <field name="arch" type="xml">
                <search string="Buscar">
                    <field name="product_id"/>
                    <field name="customer_id"/>
                    <field name="sale_id"/>
                    <field name="promo_id"/>
                    <group>
                        <filter string="Producto" name="group_by_product" domain="[]" context="{'group_by': 'product_id'}"/>
                        <filter string="Cliente" name="group_by_customer" domain="[]" context="{'group_by': 'customer_id'}"/>
                        <filter string="Pedido" name="group_by_sale" domain="[]" context="{'group_by': 'sale_id'}"/>
                        <filter string="Promoción" name="group_by_promo" domain="[]" context="{'group_by': 'promo_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="action_history_promo" model="ir.actions.act_window">
            <field name="name">Historial de Promociones</field>
            <field name="res_model">tf.history.promo</field>
            <field name="view_mode">list,form</field>
        </record>
   <record id="tf_history_promo_action_confirm" model="ir.actions.server">
        <field name="name">Actualizar Numero Factura</field>
        <field name="model_id" ref="model_tf_history_promo"/>
        <field name="binding_model_id" ref="model_tf_history_promo"/>
        <field name="state">code</field>
        <field name="code">records._get_invoiced_ver()</field>
    </record>
        <!-- <menuitem name="History Promo" id="menu_tf_history_promo_main"/> -->

        <menuitem id="menu_history_promo"
                  name="Historial de Promociones"
                  action="action_history_promo"
                  parent="sale.menu_sale_report"
                  sequence="20"/>

    </data>
</odoo>