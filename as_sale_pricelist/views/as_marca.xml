<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="as_marca_tree_view" model="ir.ui.view">
            <field name="name">as.marca.tree.view</field>
            <field name="model">as.marca</field>
            <field name="arch" type="xml">
                <list string="Marcas" editable="bottom" multi_edit="1">
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="as_marca_form" model="ir.ui.view">
            <field name="name">Marca</field>
            <field name="model">as.marca</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        Marca
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="as_marca_action" model="ir.actions.act_window">
            <field name="name">Marcas</field>
            <field name="res_model">as.marca</field>
            <field name="view_mode">list,form</field>
        </record> 

        <menuitem id="as_marca_action_menu" name="Marcas"
            parent="contacts.res_partner_menu_config" sequence="30"
            action="as_marca_action" groups="base.group_user"
        />

    </data>
</odoo>