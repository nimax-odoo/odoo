<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form2" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.certificate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="after">
                <block title="Margen en Ventas" id="margen_setting_container">
                    <setting id="as_margin_minimo_id" title="Margen minimo de venta">
                        <field name="as_margin_minimo" />
                    </setting>
                    <setting id="as_margin_global_id" title="Margen global de venta">
                        <field name="as_margin_global" />
                    </setting>
                     <setting id="as_password_ventas1_id" title="Margen global de venta">
                        <field name="as_password_ventas1" />
                    </setting>
                </block>


            </xpath>
        </field>
    </record>
</odoo>