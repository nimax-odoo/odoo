<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <template id="quiniela" name="Quiniela">
        <t t-call="website.layout">

            <span class="hidden" data-for="contactus_form" t-att-data-values="contactus_form_values" />
            <div id="wrap" class="oe_structure oe_empty">

                <div class="container">

                    <!-- Pestañas -->
                    <ul class="nav nav-tabs" role="tablist">
                        <t t-set="tab_index" t-value="0" />

                        <li t-foreach="winners" t-as="win" class="nav-item">
                            <a t-att-class="'nav-link active' if tab_index == 0 else 'nav-link'" data-bs-toggle="tab"
                                t-att-href="'#match_' + str(win.id)">

                                <span t-esc="win.name.equipo_a_name" />
                                VS
                                <span t-esc="win.name.equipo_b_name" />

                            </a>

                            <t t-set="tab_index" t-value="tab_index + 1" />
                        </li>
                    </ul>

                    <!-- Contenido de pestañas -->
                    <div class="tab-content mt-3">

                        <t t-set="content_index" t-value="0" />

                        <div t-foreach="winners" t-as="win" t-att-id="'match_' + str(win.id)"
                            t-att-class="'tab-pane fade show active' if content_index == 0 else 'tab-pane fade'">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <h2 class="mb-0 fw-bold">
                                    <span t-esc="win.name.equipo_a_name" />
                                    VS
                                    <span t-esc="win.name.equipo_b_name" />
                                </h2>

                                <div class="d-flex align-items-center" style="font-size:32px;font-weight:bold;">

                                    <img t-if="win.name.image_equipo_a" width="60" height="60" class="me-2"
                                        t-att-src="image_data_uri(win.name.image_equipo_a)" />

                                    <span t-esc="win.score_equipo_a" />

                                    <span class="mx-2">-</span>

                                    <span t-esc="win.score_equipo_b" />
                                    <img t-if="win.name.image_equipo_b" width="60" height="60" class="ms-2"
                                        t-att-src="image_data_uri(win.name.image_equipo_b)" />

                                </div>

                            </div>

<style>
    .winners-columns {
        column-count: 4;
        column-gap: 30px;
    }

    .winner-item {
        break-inside: avoid;
        border-bottom: 1px solid #eee;
        padding: 4px 0;
    }

    .winner-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .winner-score {
        font-weight: bold;
        color: #198754;
        margin-left: 10px;
    }
</style>

<div class="winners-columns">

    <t t-set="pos" t-value="1"/>

    <div t-foreach="win.proposticos_winner_ids.sorted(key=lambda r: r.puntaje, reverse=True)"
         t-as="p"
         class="winner-item">

        <div class="winner-row">

            <span>
                <strong>#<span t-esc="pos"/></strong>
                <t t-set="pos" t-value="pos + 1"/>
                -
                <b><span t-esc="p.quiniela_pronostico_id.partner_id.name"/></b>
            </span>

            <span class="winner-score">
                $<span t-esc="'{:.0f}'.format(p.puntaje)"/>
            </span>

        </div>

    </div>

</div>
