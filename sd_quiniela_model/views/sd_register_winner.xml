<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================= -->
        <!-- TREE -->
        <!-- ========================= -->
        <record id="as_register_winner_tree_view" model="ir.ui.view">
            <field name="name">sd.register.winner.tree.view</field>
            <field name="model">sd.register.winner</field>
            <field name="arch" type="xml">
                <list string="Registrar Ganador">

                    <field name="name"/>
                    <field name="ganador"/>
                    <field name="score_equipo_a"/>
                    <field name="score_equipo_b"/>

                    <!-- ✅ TIEMPO EXTRA -->
                    <field name="tiempo_extra_1"/>
                    <field name="tiempo_extra_2"/>

                </list>
            </field>
        </record>

        <!-- ========================= -->
        <!-- FORM -->
        <!-- ========================= -->
        <record id="as_register_winner_form" model="ir.ui.view">
            <field name="name">Registrar Ganador</field>
            <field name="model">sd.register.winner</field>
            <field name="arch" type="xml">
                <form>

                    <header>
                        <button name="action_extract_winner"
                                icon="fa-plus"
                                type="object"
                                class="btn-primary"
                                string="Extraer Ganadores"/>
                    </header>

                    <sheet>

                        <!-- BOTÓN GANADORES -->
                        <div name="button_box" class="oe_button_box">
                            <button type="object"
                                    name="action_open_ganadores"
                                    class="oe_stat_button"
                                    icon="fa-usd">
                                <field name="winner_count" string="Ganadores" widget="statinfo"/>
                            </button>
                        </div>

                        <!-- ENCABEZADO -->
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="ganador"/>
                            </group>
                        </group>

                        <hr/>

                        <!-- MARCADOR -->
                        <group>
                            <group>
                                <field name="score_equipo_a"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="score_equipo_b"/>
                            </group>
                        </group>

                        <hr/>

                        <!-- MINUTOS -->
                        <group>

                            <!-- T1 -->
                            <group>

                                <label for="min_0_9_t1" string="Min/Cant 0-9 T1"/>
                                <div class="o_row">
                                    <field name="min_0_9_t1"/>
                                    <field name="min_0_9_t1_cant" nolabel="1" class="ms-2"
                                           invisible="not min_0_9_t1" required="min_0_9_t1"/>
                                </div>

                                <label for="min_10_18_t1" string="Min/Cant 10-18 T1"/>
                                <div class="o_row">
                                    <field name="min_10_18_t1"/>
                                    <field name="min_10_18_t1_cant" nolabel="1" class="ms-2"
                                           invisible="not min_10_18_t1" required="min_10_18_t1"/>
                                </div>

                                <label for="min_19_27_t1" string="Min/Cant 19-27 T1"/>
                                <div class="o_row">
                                    <field name="min_19_27_t1"/>
                                    <field name="min_19_27_t1_cant" nolabel="1" class="ms-2"
                                           invisible="not min_19_27_t1" required="min_19_27_t1"/>
                                </div>

                                <label for="min_28_36_t1" string="Min/Cant 28-36 T1"/>
                                <div class="o_row">
                                    <field name="min_28_36_t1"/>
                                    <field name="min_28_36_t1_cant" nolabel="1" class="ms-2"
                                           invisible="not min_28_36_t1" required="min_28_36_t1"/>
                                </div>

                                <label for="min_37_45_t1" string="Min/Cant 37-45 T1"/>
                                <div class="o_row">
                                    <field name="min_37_45_t1"/>
                                    <field name="min_37_45_t1_cant" nolabel="1" class="ms-2"
                                           invisible="not min_37_45_t1" required="min_37_45_t1"/>
                                </div>

                            </group>

                            <!-- T2 -->
                            <group>

                                <label for="min_0_9_t2" string="Min/Cant 0-9 T2"/>
                                <div class="o_row">
                                    <field name="min_0_9_t2"/>
                                    <field name="min_0_9_t2_cant" nolabel="1" class="ms-2"
                                           invisible="not min_0_9_t2" required="min_0_9_t2"/>
                                </div>

                                <label for="min_10_18_t2" string="Min/Cant 10-18 T2"/>
                                <div class="o_row">
                                    <field name="min_10_18_t2"/>
                                    <field name="min_10_18_t2_cant" nolabel="1" class="ms-2"
                                           invisible="not min_10_18_t2" required="min_10_18_t2"/>
                                </div>

                                <label for="min_19_27_t2" string="Min/Cant 19-27 T2"/>
                                <div class="o_row">
                                    <field name="min_19_27_t2"/>
                                    <field name="min_19_27_t2_cant" nolabel="1" class="ms-2"
                                           invisible="not min_19_27_t2" required="min_19_27_t2"/>
                                </div>

                                <label for="min_28_36_t2" string="Min/Cant 28-36 T2"/>
                                <div class="o_row">
                                    <field name="min_28_36_t2"/>
                                    <field name="min_28_36_t2_cant" nolabel="1" class="ms-2"
                                           invisible="not min_28_36_t2" required="min_28_36_t2"/>
                                </div>

                                <label for="min_37_45_t2" string="Min/Cant 37-45 T2"/>
                                <div class="o_row">
                                    <field name="min_37_45_t2"/>
                                    <field name="min_37_45_t2_cant" nolabel="1" class="ms-2"
                                           invisible="not min_37_45_t2" required="min_37_45_t2"/>
                                </div>

                            </group>

                        </group>

                        <hr/>

                        <!-- ✅ TIEMPO EXTRA -->
                        <group string="Tiempo Extra">

                            <group>

                                <label for="tiempo_extra_1" string="Tiempo Extra 1"/>
                                <div class="o_row">
                                    <field name="tiempo_extra_1"/>
                                    <field name="tiempo_extra_1_cant" nolabel="1" class="ms-2"
                                           invisible="not tiempo_extra_1" required="tiempo_extra_1"/>
                                </div>

                            </group>

                            <group>

                                <label for="tiempo_extra_2" string="Tiempo Extra 2"/>
                                <div class="o_row">
                                    <field name="tiempo_extra_2"/>
                                    <field name="tiempo_extra_2_cant" nolabel="1" class="ms-2"
                                           invisible="not tiempo_extra_2" required="tiempo_extra_2"/>
                                </div>

                            </group>

                        </group>

                    </sheet>

                    <chatter reload_on_post="True"/>

                </form>
            </field>
        </record>

        <!-- ========================= -->
        <!-- ACTION -->
        <!-- ========================= -->
        <record id="as_register_winner_action" model="ir.actions.act_window">
            <field name="name">Registrar Ganador</field>
            <field name="res_model">sd.register.winner</field>
            <field name="view_mode">list,form</field>
        </record>

        as_register_winner_action

    </data>
</odoo>