<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="as_register_winner_tree_view" model="ir.ui.view">
            <field name="name">sd.register.winner.tree.view</field>
            <field name="model">sd.register.winner</field>
            <field name="arch" type="xml">
                <list string="Registrar Ganador">
                    <field name="name" />
                    <field name="min_0_9_t1" />
                    <field name="min_10_18_t1" />
                    <field name="min_19_27_t1" />
                    <field name="min_28_36_t1" />
                    <field name="min_37_45_t1" />
                    <field name="min_0_9_t2" />
                    <field name="min_10_18_t2" />
                    <field name="min_19_27_t2" />
                    <field name="min_28_36_t2" />
                    <field name="min_37_45_t2" />
                    <field name="score_equipo_a" />
                    <field name="score_equipo_b" />
                    <field name="ganador" />

                </list>
            </field>
        </record>

        <record id="as_register_winner_form" model="ir.ui.view">
            <field name="name">Registrar Ganador</field>
            <field name="model">sd.register.winner</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                    <button name="action_extract_winner" icon="fa-plus" type="object" class="btn-primary" string="Extraer Ganadores"/>
                    </header>
                    <sheet>
                    <div name="button_box" class="oe_button_box">
                            <button type="object" name="action_open_ganadores"
                              class="oe_stat_button" icon="fa-usd">
                                <field name="winner_count" string="Ganadores" widget="statinfo"/>
                            </button>
                         
                        </div>
                        <group>
                            <field name="name" />
                            <field name="ganador" />
                        </group>
                        <group>
                            <group>
                                <field name="min_0_9_t1" />
                                <field name="min_10_18_t1" />
                                <field name="min_19_27_t1" />
                                <field name="min_28_36_t1" />
                                <field name="min_37_45_t1" />
                            </group>
                            <group>
                                <field name="min_0_9_t2" />
                                <field name="min_10_18_t2" />
                                <field name="min_19_27_t2" />
                                <field name="min_28_36_t2" />
                                <field name="min_37_45_t2" />
                            </group>
                            <group>
                                <field name="score_equipo_a" />
                            </group>
                            <group>
                                <field name="score_equipo_b" />
                            </group>
                        </group>
                    </sheet>
                    <chatter reload_on_post="True"/>
                </form>
            </field>
        </record>

        <record id="as_register_winner_action" model="ir.actions.act_window">
            <field name="name">Registrar Ganador</field>
            <field name="res_model">sd.register.winner</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="as_register_winner_action_menu" name="Registrar Ganador" parent="menu_website_quinielas"
            sequence="100" action="as_register_winner_action" />

    </data>
</odoo>