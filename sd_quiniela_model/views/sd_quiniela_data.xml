<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="as_quiniela_data_tree_view" model="ir.ui.view">
            <field name="name">sd.quiniela.data.tree.view</field>
            <field name="model">sd.quiniela.data</field>
            <field name="arch" type="xml">
                <list string="Quiniela Data" editable="bottom" multi_edit="1">
                    <field name="name"/>
                    <!-- <field name="quiniela_pronostico_id" invisible="1"/> -->
                    <field name="equipo_a_id"/>
                    <field name="min_0_9_t1"/>
                    <field name="min_10_18_t1"/>
                    <field name="min_19_27_t1"/>
                    <field name="min_28_36_t1"/>
                    <field name="min_37_45_t1"/>
                    <field name="min_0_9_t2"/>
                    <field name="min_10_18_t2"/>
                    <field name="min_19_27_t2"/>
                    <field name="min_28_36_t2"/>
                    <field name="min_37_45_t2"/>
                    <field name="score_equipo_a"/>
                    <field name="score_equipo_b"/>
                    <field name="ganador"/>
                    <field name="currency_id" optional="hide"/>
                    <field name="puntaje" sum="total"/>
                    <field name="register_winner_id" optional="hide"/>
                    <field name="is_winner" optional="hide"/>

                </list>
            </field>
        </record>

        <record id="as_quiniela_data_form" model="ir.ui.view">
            <field name="name">Quiniela Data</field>
            <field name="model">sd.quiniela.data</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="quiniela_pronostico_id"/>
                            <field name="equipo_a_id"/>
                            <field name="min_0_9_t1"/>
                            <field name="min_10_18_t1"/>
                            <field name="min_19_27_t1"/>
                            <field name="min_28_36_t1"/>
                            <field name="min_37_45_t1"/>
                            <field name="min_0_9_t2"/>
                            <field name="min_10_18_t2"/>
                            <field name="min_19_27_t2"/>
                            <field name="min_28_36_t2"/>
                            <field name="min_37_45_t2"/>
                            <field name="score_equipo_a"/>
                            <field name="score_equipo_b"/>
                            <field name="ganador"/>
                            <field name="currency_id" optional="hide"/>
                            <field name="puntaje"/>
                            <field name="register_winner_id" invisible="1"/>
                            <field name="is_winner" />
                        </group>
                    </sheet>
                    <chatter reload_on_post="True"/>
                </form>
            </field>
        </record>

        <record id="as_quiniela_data_action" model="ir.actions.act_window">
            <field name="name">Quiniela Data</field>
            <field name="res_model">sd.quiniela.data</field>
            <field name="view_mode">list,form</field>
        </record> 

        <menuitem id="as_quiniela_data_action_menu" name="Quiniela Data"
            parent="menu_website_quinielas" sequence="2"
            action="as_quiniela_data_action" />

    </data>
</odoo>