<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sd_pronostico_tree_view" model="ir.ui.view">
            <field name="name">sd.quiniela.pronostico.tree.view</field>
            <field name="model">sd.quiniela.pronostico</field>
            <field name="arch" type="xml">
                <list string="Pronósticos">
                    <field name="name"/>
                    <field name="partner_id"/>
                </list>
            </field>
        </record>

        <record id="sd_pronostico_form" model="ir.ui.view">
            <field name="name">Pronósticos</field>
            <field name="model">sd.quiniela.pronostico</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_pronosticos_partidos"
                                icon="fa-plus"
                                type="object"
                                string="Cargar Partidos"/>
                    </header>
                    <sheet>
                        <group col="2">
                            <field name="name"/>
                            <field name="partner_id" required="1"/>
                        </group>

                        <field name="datas_ids"/>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="sd_pronostico_action" model="ir.actions.act_window">
            <field name="name">Pronósticos</field>
            <field name="res_model">sd.quiniela.pronostico</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="sd_pronostico_action_menu"
                  name="Pronósticos"
                  parent="menu_website_quinielas"
                  sequence="1"
                  action="sd_pronostico_action"/>

    </data>
</odoo>