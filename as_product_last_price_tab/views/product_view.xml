<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Form View -->
    <record id="as_product_template_form_view" model="ir.ui.view">
        <field name="name">as.product.template.last.price.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Last Prices" name="last_prices" groups="purchase.group_purchase_user">
                    <group>
                        <group string="Last Purchase" name="last_purchase">
                            <field name="as_last_supplier_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="as_last_purchase_price" readonly="1" widget="monetary"/>
                            <field name="as_last_purchase_date" readonly="1"/>
                        </group>
                        <group string="Last Sale" name="last_sale">
                            <field name="as_last_customer_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="as_last_sale_price" readonly="1" widget="monetary"/>
                            <field name="as_last_sale_date" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Product Variant Form View -->
    <record id="as_product_normal_form_view" model="ir.ui.view">
        <field name="name">as.product.product.last.price.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Last Prices" name="last_prices" groups="purchase.group_purchase_user">
                    <group>
                        <group string="Last Purchase" name="last_purchase">
                            <field name="as_last_supplier_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="as_last_purchase_price" readonly="1" widget="monetary"/>
                            <field name="as_last_purchase_date" readonly="1"/>
                        </group>
                        <group string="Last Sale" name="last_sale">
                            <field name="as_last_customer_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="as_last_sale_price" readonly="1" widget="monetary"/>
                            <field name="as_last_sale_date" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
