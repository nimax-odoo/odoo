<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Columna "Solicitar a Fabrica" en las líneas del pedido.
         Si ya sale duplicada, desactiva ESTA vista (Ajustes > Técnico > Vistas). -->
    <record id="view_order_form_nx_fabrica_lineas" model="ir.ui.view">
        <field name="name">sale.order.form.nx.fabrica.lineas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="x_studio_linea_product_fabric" string="Solicitar a Fabrica" optional="show"
                       readonly="nx_oc_nombre"/>
                <field name="nx_oc_nombre" string="OC (Logística)" readonly="1" optional="hide"/>
                <field name="nx_estado" string="Estado fábrica" widget="badge" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_nx_fabrica_datos" model="ir.ui.view">
        <field name="name">sale.order.form.nx.fabrica.datos</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Datos de fábrica" name="nx_fabrica_datos">
                    <group>
                        <group>
                            <field name="x_studio_fecha_oc_cliente"/>
                            <field name="x_studio_proyecto_otras_marcas"/>
                        </group>
                        <group>
                            <field name="x_studio_price_concession_zebra"/>
                            <field name="x_studio_dr_zebra"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
