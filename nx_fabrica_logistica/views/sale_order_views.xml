<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Checkbox simple "A fábrica" justo antes de la descripción (junto al producto).
         Si sale duplicada, desactiva ESTA vista (Ajustes > Técnico > Vistas). -->
    <record id="view_order_form_nx_fabrica_lineas" model="ir.ui.view">
        <field name="name">sale.order.form.nx.fabrica.lineas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="before">
                <field name="x_studio_linea_product_fabric" string="A fábrica"
                       optional="show" readonly="nx_oc_nombre"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="nx_oc_nombre" string="OC (Logística)" readonly="1" optional="hide"/>
                <field name="nx_estado" string="Estado fábrica" widget="badge" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Pestaña con SOLO las líneas solicitadas a fábrica + sus notas de Ventas -->
    <record id="view_order_form_nx_fabrica_datos" model="ir.ui.view">
        <field name="name">sale.order.form.nx.fabrica.datos</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Solicitado a fábrica" name="nx_fabrica_datos">
                    <group>
                        <group>
                            <field name="x_studio_price_concession_zebra"/>
                        </group>
                        <group>
                            <field name="x_studio_dr_zebra"/>
                        </group>
                    </group>
                    <field name="nx_lineas_fabrica_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_qty" string="Cantidad" readonly="1"/>
                            <field name="nx_estado" string="Estado" widget="badge" readonly="1"/>
                            <field name="x_studio_nota_venta" string="Nota (Ventas)"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
