<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pestaña con SOLO las líneas que vienen de un pedido de venta:
         ahí Logística captura la Orden del fabricante y la nota de Compras. -->
    <record id="purchase_order_form_nx_fabrica" model="ir.ui.view">
        <field name="name">purchase.order.form.nx.fabrica</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Solicitado a fábrica" name="nx_fabrica_compra">
                    <field name="nx_lineas_venta_ids" nolabel="1" readonly="state == 'cancel'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sale_order_id" string="Pedido de venta" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" string="Cantidad" readonly="1"/>
                            <field name="x_studio_orden_fabricante" string="Orden del fabricante"/>
                            <field name="x_studio_nota_compra" string="Nota (Compras)"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
