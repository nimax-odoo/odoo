<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_nx_fabrica" model="ir.ui.view">
        <field name="name">purchase.order.form.nx.fabrica</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="sale_order_id" string="Pedido de venta" readonly="1" optional="show"
                       groups="sales_team.group_sale_salesman"/>
                <field name="x_studio_orden_fabricante" string="Orden del fabricante" optional="show"/>
                <field name="x_studio_nota_compra" string="Nota (Compras)" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
